    {
      "name": "Orders Queue",
      "item": [
        {
          "name": "Queue Order - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 202', () => pm.response.to.have.status(202));\nconst body = pm.response.json();\npm.expect(body.orderId).to.eql(pm.collectionVariables.get('orderId'));\npm.expect(body.queue).to.eql('order-processing-queue');\npm.expect(body.statusUrl).to.contain('/orders/');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"customerName\": \"Jane Smith\",\n  \"SelectedItemSKUs\": [\"COF-001\", \"PAS-104\"],\n  \"totalPrice\": 65.00,\n  \"orderTimestamp\": \"2026-10-12T10:15:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders/queue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "queue"
              ]
            },
            "description": "Queues a valid order and verifies the client receives an immediate accepted response rather than waiting for preparation."
          },
          "response": []
        },
        {
          "name": "Get Order Status - Existing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));\nconst body = pm.response.json();\npm.expect(body.orderId).to.eql(pm.collectionVariables.get('orderId'));\npm.expect(body.status).to.be.oneOf(['Received', 'Preparing', 'Ready', 'Collected']);\npm.expect(body).to.have.property('lastUpdated');"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "   const url = pm.variables.replaceIn(\"{{baseUrl}}/orders/{{orderId}}/status\");\r\n   let tries = 0;\r\n   const maxTries = 15;\r\n\r\n   function poll() {\r\n       pm.sendRequest(url, function (err, res) {\r\n           tries++;\r\n           if ((!err && res.code === 200) || tries >= maxTries) {\r\n               return;\r\n           }\r\n           setTimeout(poll, 5000);\r\n       });\r\n   }\r\n   poll();"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "status"
              ]
            },
            "description": "Run after Queue Order - Success. If the worker is still processing, send this request again until the status is Collected."
          },
          "response": []
        },
        {
          "name": "Get Order Status - Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.expect(pm.response.json()).to.have.property('error');"
                ],
